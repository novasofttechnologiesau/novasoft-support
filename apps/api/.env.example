# Run python3 scripts/configure_local.py from the repository root.
DATABASE_URL=
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173,http://localhost:1420,tauri://localhost,http://tauri.localhost
AI_PROVIDER=mock
# Explicitly opt in before sending ticket/diagnostic context to DeepSeek.
ALLOW_EXTERNAL_AI=false
DEEPSEEK_API_KEY=
AI_MODEL=deepseek-chat
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
ALLOW_DEMO_SEED=false
DEMO_SEED_PASSWORD=
